generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String    @unique
  industry       String?
  website        String?
  city           String?
  state          String?
  address        String?
  contactsCount  Int?      @default(0) @map("contacts_count")
  totalDealValue Decimal?  @default(0) @map("total_deal_value") @db.Decimal
  createdAt      DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  @@map("companies")
}

model Lead {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  company      String?
  email        String?
  phone        String?
  status       String?   @default("New")
  score        Int?      @default(0)
  owner        String?
  customValues Json?     @default("{}") @map("custom_values")
  activities   Json?     @default("[]")
  createdAt    DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  @@map("leads")
}

model Deal {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  company       String?
  value         Decimal?  @default(0) @db.Decimal
  probability   Int?      @default(0)
  stage         String?   @default("New")
  owner         String?
  expectedClose DateTime? @map("expected_close") @db.Date
  lostReason    String?   @map("lost_reason")
  daysInStage   Int?      @default(0) @map("days_in_stage")
  createdAt     DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  @@map("deals")
}

model Task {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  assignee    String?
  dueDate     DateTime? @map("due_date") @db.Date
  priority    String?   @default("Medium")
  status      String?   @default("Open")
  linkedTo    String?   @map("linked_to")
  isTeam      Boolean?  @default(false) @map("is_team")
  createdAt   DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  @@map("tasks")
}

model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName      String    @unique @map("full_name")
  email         String    @unique
  password      String    @default("12345678")
  role          String?   @default("SALES_REP")
  isActive      Boolean?  @default(true) @map("is_active")
  assignedCount Int?      @default(0) @map("assigned_count")
  createdAt     DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  @@map("users_list")
}

model Quote {
  id                 String    @id
  dealId             String?   @map("deal_id") @db.Uuid
  company            String
  contact            String?
  gstType            String?   @default("intra") @map("gst_type")
  items              Json?     @default("[]")
  status             String?   @default("Draft")
  totalAmount        Decimal?  @default(0) @map("total_amount") @db.Decimal
  termsAndConditions String?   @map("terms_and_conditions")
  createdAt          DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  @@map("quotes")
}

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user        String
  action      String
  entity      String
  timestamp   DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  beforeState String?   @map("before_state")
  afterState  String?   @map("after_state")

  @@map("audit_logs")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model custom_fields {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label      String
  entity     String?   @default("Lead")
  type       String?   @default("text")
  created_at DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model terms_templates {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  content    String?
  created_at DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}

model OwnerFeedback {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageTab    String    @map("page_tab")
  category   String    @default("Requirement")
  noteText   String    @map("note_text")
  authorName String?   @default("CRM Owner") @map("author_name")
  status     String?   @default("New")
  createdAt  DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  @@map("owner_feedback")
}

model Contact {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  preferredPhone  String?   @map("preferred_phone")
  alternatePhones Json?     @default("[]") @map("alternate_phones")
  email           String?
  alternateEmails Json?     @default("[]") @map("alternate_emails")
  company         String?
  designation     String?
  city            String?
  state           String?
  address         String?
  category        String?   @default("Prospect")
  sourceType      String?   @default("Direct") @map("source_type")
  sourceEvent     String?   @map("source_event")
  sourceHistory   Json?     @default("[]") @map("source_history")
  doNotContact    Boolean?  @default(false) @map("do_not_contact")
  consentGiven    Boolean?  @default(true) @map("consent_given")
  notes           String?
  tags            Json?     @default("[]")
  customFields    Json?     @default("{}") @map("custom_fields")
  owner           String?
  lastContactedAt DateTime? @map("last_contacted_at") @db.Timestamptz(6)
  importBatchId   String?   @map("import_batch_id") @db.Uuid
  createdAt       DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("updated_at") @db.Timestamptz(6)

  @@map("contacts")
}

model Communication {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId    String    @map("contact_id") @db.Uuid
  type         String
  direction    String?   @default("Outbound")
  subject      String?
  notes        String?
  templateUsed String?   @map("template_used")
  autoLogged   Boolean?  @default(false) @map("auto_logged")
  loggedBy     String?   @map("logged_by")
  createdAt    DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  @@map("communications")
}

model ImportBatch {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fileName      String    @map("file_name")
  sourceType    String?   @default("Excel Import") @map("source_type")
  sourceEvent   String?   @map("source_event")
  totalRows     Int       @default(0) @map("total_rows")
  importedCount Int       @default(0) @map("imported_count")
  mergedCount   Int       @default(0) @map("merged_count")
  failedCount   Int       @default(0) @map("failed_count")
  uploadedBy    String?   @map("uploaded_by")
  isRolledBack  Boolean?  @default(false) @map("is_rolled_back")
  createdAt     DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  @@map("import_batches")
}

model ContactMergeLog {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  primaryContactId   String    @map("primary_contact_id") @db.Uuid
  secondaryContactId String?   @map("secondary_contact_id")
  mergedFromSnapshot Json      @map("merged_from_snapshot")
  fieldOverrides     Json?     @default("{}") @map("field_overrides")
  mergedBy           String?   @map("merged_by")
  createdAt          DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamptz(6)

  @@map("contact_merge_logs")
}

